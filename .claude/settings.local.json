      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(echo \"=== EXIT $? ===\")"
    ]
  }
